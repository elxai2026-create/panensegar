---
import Gambar from '../components/Gambar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WAButton from '../components/WAButton.astro';
import { getSiteProfile } from '../lib/catalog';
import { formatAddress } from '../lib/schema';
import { waDisplayNumber } from '../lib/whatsapp';

const profile = await getSiteProfile();
const { brand, about, contact } = profile;
const address = formatAddress(contact.address);
const title = 'Tentang Kami';
---

<BaseLayout title={title} description={about.summary}>
  <section class="border-b border-soil-100 bg-brand-50/50">
    <div class="container-page py-10">
      <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: title }]} />
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{brand.name}</h1>
      <p class="prose-desc mt-3 max-w-2xl">{about.summary}</p>
    </div>
  </section>

  {
    brand.logo && (
      <div class="container-page -mt-8">
        <Gambar
          src={brand.logo}
          alt={`Logo ${brand.name}`}
          width={112}
          height={112}
          loading="eager"
          class="h-24 w-24 rounded-2xl border-4 border-white bg-white shadow-card sm:h-28 sm:w-28"
        />
      </div>
    )
  }

  <section class="container-page py-12">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="section-title">Cerita kami</h2>
        <div class="mt-5 space-y-4">
          {about.story.map((paragraph) => (
            <p class="prose-desc text-pretty">{paragraph}</p>
          ))}
        </div>

        <h2 class="section-title mt-12">Visi</h2>
        <p class="prose-desc mt-3">{about.vision}</p>

        <h2 class="section-title mt-10">Misi</h2>
        <ul class="mt-4 space-y-3">
          {about.mission.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">
                ✓
              </span>
              <span class="prose-desc">{item}</span>
            </li>
          ))}
        </ul>

        <h2 class="section-title mt-12">Keunggulan kami</h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {about.highlights.map((highlight) => (
            <li class="card p-5">
              <span class="text-2xl" aria-hidden="true">
                {highlight.emoji}
              </span>
              <h3 class="mt-2 font-bold">{highlight.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-soil-700">{highlight.description}</p>
            </li>
          ))}
        </ul>

        {
          about.certifications.length > 0 && (
            <>
              <h2 class="section-title mt-12">Sertifikasi</h2>
              <ul class="mt-4 space-y-2">
                {about.certifications.map((cert) => (
                  <li class="flex items-center gap-3 rounded-xl bg-brand-50 px-4 py-3 text-sm font-semibold text-brand-800">
                    <span aria-hidden="true">🏅</span>
                    {cert}
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <h2 class="section-title mt-12">Wilayah pengiriman</h2>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {about.markets.map((market) => (
            <li class="flex items-center gap-2 text-sm text-soil-700">
              <span class="text-brand-600" aria-hidden="true">
                ▸
              </span>
              {market}
            </li>
          ))}
        </ul>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="card p-6">
          <h2 class="font-bold">Hubungi kami</h2>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="text-soil-500">WhatsApp</dt>
              <dd class="mt-0.5 font-bold text-brand-700">
                {waDisplayNumber(contact.whatsapp)}
              </dd>
            </div>
            {contact.email && (
              <div>
                <dt class="text-soil-500">Email</dt>
                <dd class="mt-0.5 font-semibold break-all">{contact.email}</dd>
              </div>
            )}
            <div>
              <dt class="text-soil-500">Alamat</dt>
              <dd class="mt-0.5 leading-relaxed">{address}</dd>
            </div>
          </dl>

          {contact.mapsUrl && (
            <a
              href={contact.mapsUrl}
              target="_blank"
              rel="noopener"
              class="mt-4 block text-sm font-semibold text-brand-700 underline decoration-dotted underline-offset-4"
            >
              Lihat di peta
            </a>
          )}

          <div class="mt-6">
            <WAButton block size="lg" />
          </div>
        </div>

        <div class="card mt-4 p-6">
          <h2 class="font-bold">Jam kerja</h2>
          <dl class="mt-4 space-y-2 text-sm">
            {contact.businessHours.map((row) => (
              <div class="flex justify-between gap-3">
                <dt class="text-soil-500">{row.label}</dt>
                <dd class="text-right font-semibold">{row.hours}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 text-xs text-soil-500">
            Dibuat sejak {about.foundedYear}. Pesanan di luar jam kerja dibalas pada hari berikutnya.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-page pb-4">
    <div class="rounded-3xl bg-brand-900 p-8 text-brand-50 sm:p-12">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-balance sm:text-3xl">{profile.closing.title}</h2>
        <p class="mt-3 leading-relaxed text-brand-100/85">{profile.closing.description}</p>
        <div class="mt-8">
          <WAButton size="lg" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>