---
import BaseLayout from '../layouts/BaseLayout.astro';
import WAButton from '../components/WAButton.astro';
import { pagePath } from '../lib/catalog';

const suggestions = [
  { href: pagePath('produk'), label: 'Katalog produk', desc: 'Lihat seluruh produk dan harga terbaru.' },
  { href: pagePath('tentang-kami'), label: 'Tentang kami', desc: 'Profil usaha, visi, misi, dan lokasi.' },
  { href: pagePath(''), label: 'Beranda', desc: 'Kembali ke halaman utama.' },
];
---

<BaseLayout title="Halaman tidak ditemukan" noindex>
  <div class="container-page flex min-h-[60vh] flex-col justify-center py-16">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
      Halaman ini tidak ditemukan
    </h1>
    <p class="prose-desc mt-4 max-w-xl text-lg">
      Alamat yang Anda buka mungkin sudah berubah atau produknya sudah habis. Coba pilih salah satu
      tautan di bawah ini.
    </p>

    <ul class="mt-8 grid max-w-2xl gap-3 sm:grid-cols-3">
      {
        suggestions.map((item) => (
          <li>
            <a
              href={item.href}
              class="card block h-full p-5 hover:-translate-y-0.5 hover:shadow-card-hover"
            >
              <span class="font-bold text-brand-700">{item.label}</span>
              <span class="mt-1 block text-sm text-soil-700">{item.desc}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <WAButton size="lg" label="Tanya stok via WhatsApp" />
    </div>
  </div>
</BaseLayout>