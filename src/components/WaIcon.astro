---
/**
 * Ikon WhatsApp. Astro meneruskan `class` sebagai prop bernama `class`,
 * jadi `className` hanya dipakai sebagai nama lama agar pemanggil
 * dengan gaya lama tidak kehilangan ukuran ikon.
 */
interface Props {
  class?: string;
  className?: string;
}

const { class: classProp, className } = Astro.props;
const size = 'h-[1.15em] w-[1.15em] shrink-0';
---

