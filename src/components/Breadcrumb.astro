---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Remah roti">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-soil-500">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && (
            <span aria-hidden="true" class="text-soil-300">
              /
            </span>
          )}
          {item.href ? (
            <a href={item.href} class="transition hover:text-brand-700 hover:underline">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="font-semibold text-soil-700">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>