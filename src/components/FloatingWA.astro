---
interface Props {
  href: string;
  /** Disembunyikan di halaman yang tidak relevan, misal 404. */
  label?: string;
}

const { href, label = 'Pesan via WhatsApp' } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={label}
  class="fixed right-4 bottom-4 z-50 grid h-14 w-14 place-items-center rounded-full bg-wa-500 text-white shadow-lg shadow-black/20 transition hover:bg-wa-600 active:scale-95 sm:right-6 sm:bottom-6"
>
  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.51 8.51 0 0 1 2.41 5.82c0 4.71-3.84 8.55-8.55 8.55a8.5 8.5 0 0 1-4.34-1.19l-.31-.18-3.24.85.86-3.16-.2-.32a8.46 8.46 0 0 1-1.3-4.55c0-4.71 3.84-8.54 8.55-8.54Zm-2.4 4.2c-.2 0-.52.08-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.06 3.29 5.09 4.48 2.53.99 3.03.79 3.58.74.55-.05 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57Z"
    ></path>
