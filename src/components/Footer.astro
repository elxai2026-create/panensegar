---
import Gambar from '../components/Gambar.astro';
import type { SiteProfile } from '../lib/catalog';
import { categoryPath, getCategories, pagePath } from '../lib/catalog';
import { formatAddress } from '../lib/schema';
import { waDisplayNumber } from '../lib/whatsapp';

interface Props {
  brand: SiteProfile['brand'];
  profile: SiteProfile;
}

const { brand, profile } = Astro.props;
const { contact, about } = profile;
const year = new Date().getFullYear();
const address = formatAddress(contact.address);

const nav = [
  { href: pagePath('produk'), label: 'Semua Produk' },
  // Kategori diambil dari data, bukan ditulis manual, supaya label baru
  // ikut muncul begitu CMS menambah kategori.
  ...(await getCategories()).map((c) => ({ href: categoryPath(c.id), label: c.data.name })),
];
---

<footer class="mt-20 border-t border-soil-100 bg-brand-950 text-brand-50">
  <div class="container-page py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2.5">
          {
            brand.logo && (
              <Gambar src={brand.logo} alt="" width={32} height={32} class="h-8 w-8" loading="lazy" />
            )
          }
          <span class="text-lg font-extrabold">{brand.name}</span>
        </div>
        {brand.legalName && <p class="mt-3 text-sm text-brand-200">{brand.legalName}</p>}
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-brand-100/80">{about.summary}</p>
      </div>

      <nav aria-label="Kategori produk">
        <h2 class="text-sm font-bold tracking-widest text-brand-300 uppercase">Kategori</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-brand-100/80 transition hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-bold tracking-widest text-brand-300 uppercase">Hubungi Kami</h2>
        <ul class="mt-4 space-y-2.5 text-sm text-brand-100/80">
          <li>
            <a
              href={`https://wa.me/${contact.whatsapp}`}
              target="_blank"
              rel="noopener"
              class="transition hover:text-white"
            >
              WhatsApp {waDisplayNumber(contact.whatsapp)}
            </a>
          </li>
          {
            contact.email && (
              <li>
                <a href={`mailto:${contact.email}`} class="transition hover:text-white">
                  {contact.email}
                </a>
              </li>
            )
          }
          <li>{address}</li>
          {
            contact.mapsUrl && (
              <li>
                <a
                  href={contact.mapsUrl}
                  target="_blank"
                  rel="noopener"
                  class="underline decoration-dotted underline-offset-4 transition hover:text-white"
                >
                  Lihat di peta
                </a>
              </li>
            )
          }
        </ul>

        <h2 class="mt-6 text-sm font-bold tracking-widest text-brand-300 uppercase">Jam Kerja</h2>
        <ul class="mt-3 space-y-1.5 text-sm text-brand-100/80">
          {
            contact.businessHours.map((row) => (
              <li class="flex justify-between gap-3">
                <span>{row.label}</span>
                <span class="text-right">{row.hours}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-brand-200/70 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {brand.legalName || brand.name}. Seluruh hak dilindungi.</p>
      <p>Harga dapat berubah mengikuti musim. Konfirmasi stok via WhatsApp.</p>
    </div>
  </div>
</footer>